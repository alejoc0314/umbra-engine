/* umbra watch: disposición y colores por nombre ($state-*, $stage-* vienen del tema) */

Screen {
    background: $background;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#tasks {
    height: 32%;
    border: round $border;
    border-title-color: $text-muted;
}
#tasks:focus {
    border: round $primary;
}
#tasks > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: $block-cursor-text-style;
}

#attempts {
    height: 7;
    border: round $border;
    border-title-color: $text-muted;
}

#specs {
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: $text-muted;
}

#middle {
    height: 1fr;
}
#situation {
    width: 50%;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    padding: 0 1;
}
#right {
    width: 1fr;
    height: 1fr;
    border: round $border;
    border-title-color: $text-muted;
}
#log, #agent, #evidence, #changes, #memory {
    height: 1fr;
    padding: 0 1;
}
#changes-files { margin-bottom: 1; }

/* terminal estrecha: situación y panel derecho apilados */
Screen.-narrow #middle { layout: vertical; }
Screen.-narrow #situation { width: 100%; height: 50%; }
Screen.-narrow #right { width: 100%; }

/* modales */
Confirm, AskText, PickStage, PickOne, TextView {
    align: center middle;
}
Confirm #box {
    width: 100; height: auto; max-height: 90%;
    border: thick $warning; padding: 1 2; background: $surface;
}
Confirm #body { height: auto; max-height: 30; }
Confirm #buttons { height: 3; margin-top: 1; }
Confirm .question { text-style: bold; margin-bottom: 1; }
AskText #box {
    width: 70; height: auto; border: thick $warning; padding: 1 2; background: $surface;
}
AskText .hint { color: $text-muted; }
PickStage #box {
    width: 60; height: auto; border: thick $accent; padding: 1 2; background: $surface;
}
PickOne #box {
    width: 90; height: auto; max-height: 90%; border: thick $accent; padding: 1 2;
    background: $surface;
}
TextView #box {
    width: 90%; height: 85%; border: thick $accent; padding: 0 1; background: $surface;
}

/* pantalla de spec (dentro de watch) */
SpecScreen {
    background: $background;
}
SpecScreen #history { height: 1fr; border: round $border; padding: 0 1; }
SpecScreen #live { height: auto; max-height: 10; padding: 0 1; color: $text; }
SpecScreen #activity, SpecScreen #bar { height: 1; color: $text-muted; padding: 0 1; }
SpecScreen #entry { border: tall $primary; }
